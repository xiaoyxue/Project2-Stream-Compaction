{
    "files.associations": {
        "*.cu": "cuda-cpp",
        "*.cuh": "cuda-cpp"
    },
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.default.configurationProvider": "",
    "clangd.enable": false,
    "cmake.generator": "Visual Studio 18 2026",
    "cmake.platform": "x64",
    "cmake.toolset": "cuda=${workspaceFolder}\\build\\cuda-12.9",
    "cmake.buildDirectory": "${workspaceFolder}\\build",
    "cmake.configureSettings": {
        "CMAKE_VS_GLOBALS": "VCToolsVersion=14.44.35207",
        "CMAKE_TRY_COMPILE_PLATFORM_VARIABLES": "CMAKE_VS_GLOBALS"
    }
}
